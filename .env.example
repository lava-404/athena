# --- Privy (auth) ---
# Create an app at https://dashboard.privy.io — App ID is public (safe in
# NEXT_PUBLIC_*), it identifies which Privy app to talk to, not a secret.
NEXT_PUBLIC_PRIVY_APP_ID=cmsekn26u010c0cla7weegwy3

# --- AI backend (see backend/.env.example for its own required vars) ---
NEXT_PUBLIC_BACKEND_HTTP_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000

# --- LiveKit (optional — only needed for real multi-participant rooms) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=
